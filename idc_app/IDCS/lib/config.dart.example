// 이 파일은 lib/config.dart 의 견본이다.
// lib/config.dart 는 개발자마다 서버 주소가 달라 .gitignore 에 등록되어 있으므로,
// 처음 받았을 때 이 파일을 lib/config.dart 로 복사한 뒤 주소만 본인 환경에 맞게 고치면 된다.
//
// [주의] 예전에는 이 파일 안에 AuthService 도 같이 들어 있었다.
// AuthService 는 모두가 공유하는 로직이라 lib/auth_service.dart 로 분리했으므로,
// 기존에 쓰던 lib/config.dart 에 AuthService 가 남아 있다면 그 부분은 지워야 한다.
// (그대로 두면 클래스가 중복 정의되어 빌드가 깨진다)

// 경로: lib/config.dart
part of 'main.dart';

class AppConfig {
  // 로컬에서 백엔드를 직접 띄워 쓰는 경우
  static const String baseUrl = 'http://localhost:8000/api';
  static const String basewsUrl = 'ws://localhost:8000/api';

  // 같은 공유기 안의 다른 PC에서 띄운 백엔드에 붙는 경우 예시
  // static const String baseUrl = 'http://192.168.0.10:8000/api';
  // static const String basewsUrl = 'ws://192.168.0.10:8000/api';

  // 💡 향후 추가될 모든 초기화 로직은 main.dart가 아닌 여기에 추가합니다.
  static Future<void> initializeAll() async {
    await initializeDateFormatting('ko_KR', null);
    await Firebase.initializeApp(options: DefaultFirebaseOptions.currentPlatform);
    await AuthService.init(); // 로그인 상태 로컬 저장소에서 불러오기
  }
}
