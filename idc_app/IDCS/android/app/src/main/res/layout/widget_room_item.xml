<?xml version="1.0" encoding="utf-8"?>
<!-- 위젯 안 호실 카드 한 칸. 앱 카드와 같은 순서: 이름 → 온도 → 설정값·Δ → 상태 띠 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="9dp"
        android:paddingTop="7dp"
        android:paddingEnd="9dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/item_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/widget_text"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/item_faults"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widget_error"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/item_rule_top"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="3dp"
            android:background="@color/widget_rule" />

        <!-- 온도는 오른쪽에 붙이고, 마이너스는 늘 자기 자리에 있다(영하일 때만 켜짐). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:gravity="end|top"
            android:orientation="horizontal"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/item_minus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dseg7_bold"
                android:includeFontPadding="false"
                android:text="-"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/item_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/dseg7_bold"
                android:includeFontPadding="false"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/item_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:layout_marginStart="2dp"
                android:text="°C"
                android:textColor="@color/widget_text_secondary"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/item_rule_bottom"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/widget_rule" />

        <TextView
            android:id="@+id/item_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 상태 띠 -->
    <FrameLayout
        android:id="@+id/item_rail"
        android:layout_width="match_parent"
        android:layout_height="5dp" />
</LinearLayout>
